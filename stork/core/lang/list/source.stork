
  some(head)(tail)(vSome)(vNone) {
    vSome(head)(tail)
  }

  none(vSome)(vNone) {
    vNone
  }


  hasSome(list) {
    list
      ((head)(tail) { true })
      (false)
  }

  hasNone {
    .hasSome.not
  }


  single(element) {
    some(element)(none)
  }

  repeat(element) {
    some
      (element)
      (repeat(element))
  }

  cycle(list) {
    hasSome(list)
      (list.append(cycle(list)))
      (none)
  }

  iterate(next)(first) {
    some
      (first)
      (iterate(next)(next(first)))
  }


  each(transform)(list) {
    list
      ((head)(tail) {
        some
          (head.transform)
          (tail.each(transform))
      })
      (none)
  }

  reduce(seed)(accumulator)(list) {
    list
      ((head)(tail) {
        reduce
          (accumulator(head)(seed))
          (accumulator)
          (tail)
      })
      (seed)
  }

  reduceEager(sum)(add)(list) {
    list
      ((head)(tail) {
        EAGER(reduceEager)
          (add(head)(sum))
          (add)
          (tail)
      })
      (sum)
  }

  filter(predicate)(list) {
    list
      ((head)(tail) {
        predicate(head)
          (some(head)(tail.filter(predicate)))
          (tail.filter(predicate))
      })
      (none)
  }

  limit(n)(list) {
    moreThan(0)(n)
      (list
        ((head)(tail) {
          some(head)(tail.limit(n.decrement))
        })
        (none))
      (none)
  }

  skip(n)(list) {
    moreThan(0)(n)
      (list
        ((head)(tail) {
          tail.skip(n.decrement)
        })
        (none))
      (list)
  }

  while(predicate)(list) {
    list
      ((head)(tail) {
        predicate(head)
          (some(head)(tail.while(predicate)))
          (none)
      })
      (none)
  }

  since(predicate)(list) {
    list
      ((head)(tail) {
        predicate(head)
          (list)
          (since(predicate)(tail))
      })
      (none)
  }

  until(predicate)(list) {
    list
      ((head)(tail) {
        predicate(head)
          (some(head)(none))
          (some(head)(tail.until(predicate)))
      })
      (none)
  }

  before(predicate) {
    while(.predicate.not)
  }

  after(predicate) {
    .since(predicate)
    .skip(1)
  }

  append(suffix)(list) {
    list
      ((head)(tail) {
        some(head)(tail.append(suffix))
      })
      (suffix)
  }

  prepend {
    flip(append)
  }

  splitAround(separator)(list) {
    some
      (list
        .before(separator))
      (list
        .since(separator)
        .splitAround2(separator))
  }

  splitAround2(separator)(list) {
    hasSome(list)
      (some
        (list
          .skip(1)
          .before(separator))
        (list
          .skip(1)
          .since(separator)
          .splitAround2(separator)))
      (none)
  }

  flatten(lists) {
    lists
      ((head)(tail) {
        head.append(tail.flatten)
      })
      (none)
  }

  transpose(lists) {
    hasSome(lists)
      (some
        (lists
           .each(limit(1))
           .flatten)
        (lists
          .each(skip(1))
          .filter(hasSome)
          .transpose))
      (none)
  }

  prefixes(list) {
    list
      ((head)(tail) {
        some
          (none)
          (prefixes(tail)
            .each(prepend(single(head))))
      })
      (single(none))
  }

  suffixes(list) {
    list
      ((head)(tail) {
        some(list)(suffixes(tail))
      })
      (single(none))
  }

  equal(equalElements)(listA)(listB) {
    listA
      ((headA)(tailA) {
        listB
          ((headB)(tailB) {
            and
              (equalElements(headA)(headB))
              (equal(equalElements)(tailA)(tailB))
          })
          (false)
      })
      (hasNone(listB))
  }

  startsWith(equal)(prefix)(list) {
    prefix
      ((prefixHead)(prefixTail) {
        list
          ((head)(tail) {
            and
              (equal(prefixHead)(head))
              (startsWith(equal)(prefixTail)(tail))
          })
          (false)
      })
      (true)
  }

  length {
    reduce(0)(constant(increment))
  }

  contains(predicate)(list) {
    list
      .filter(predicate)
      .hasSome
  }

  reverse {
    reduce(none)(some)
  }

  sort(comparator)(list) {
    list
      ((head)(tail) {
        single(head)
          .prepend(tail
            .filter(.comparator(head).not)
            .sort(comparator))
          .append(tail
            .filter(comparator(head))
            .sort(comparator))
      })
      (none)
  }

