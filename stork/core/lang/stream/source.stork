
  some(head)(tail)(vSome)(vNone) {
    vSome(head)(tail)
  }

  none(vSome)(vNone) {
    vNone
  }


  hasSome(stream) {
    stream
      ((head)(tail) { true })
      (false)
  }

  hasNone {
    .hasSome.not
  }


  single(element) {
    some(element)(none)
  }

  repeat(element) {
    some
      (element)
      (repeat(element))
  }

  cycle(stream) {
    hasSome(stream)
      (stream.append(cycle(stream)))
      (none)
  }

  iterate(next)(first) {
    some
      (first)
      (iterate(next)(next(first)))
  }


  each(transform)(stream) {
    stream
      ((head)(tail) {
        some
          (head.transform)
          (tail.each(transform))
      })
      (none)
  }

  reduce(seed)(accumulator)(stream) {
    stream
      ((head)(tail) {
        reduce
          (accumulator(head)(seed))
          (accumulator)
          (tail)
      })
      (seed)
  }

  reduceEager(sum)(add)(stream) {
    stream
      ((head)(tail) {
        EAGER(reduceEager)
          (add(head)(sum))
          (add)
          (tail)
      })
      (sum)
  }

  filter(predicate)(stream) {
    stream
      ((head)(tail) {
        predicate(head)
          (some(head)(tail.filter(predicate)))
          (tail.filter(predicate))
      })
      (none)
  }

  limit(n)(stream) {
    moreThan(0)(n)
      (stream
        ((head)(tail) {
          some(head)(tail.limit(n.decrement))
        })
        (none))
      (none)
  }

  skip(n)(stream) {
    moreThan(0)(n)
      (stream
        ((head)(tail) {
          tail.skip(n.decrement)
        })
        (none))
      (stream)
  }

  while(predicate)(stream) {
    stream
      ((head)(tail) {
        predicate(head)
          (some(head)(tail.while(predicate)))
          (none)
      })
      (none)
  }

  since(predicate)(stream) {
    stream
      ((head)(tail) {
        predicate(head)
          (stream)
          (since(predicate)(tail))
      })
      (none)
  }

  until(predicate)(stream) {
    stream
      ((head)(tail) {
        predicate(head)
          (some(head)(none))
          (some(head)(tail.until(predicate)))
      })
      (none)
  }


  append(secondStream)(stream) {
    stream
      ((head)(tail) {
        some(head)(tail.append(secondStream))
      })
      (secondStream)
  }

  prepend {
    flip(append)
  }

  flatten(streams) {
    streams
      ((head)(tail) {
        head.append(tail.flatten)
      })
      (none)
  }

  transpose(streams) {
    hasSome(streams)
      (some
        (streams
           .each(limit(1))
           .flatten)
        (streams
          .each(skip(1))
          .filter(hasSome)
          .transpose))
      (none)
  }

  equal(equalElements)(streamA)(streamB) {
    streamA
      ((headA)(tailA) {
        streamB
          ((headB)(tailB) {
            and
              (equalElements(headA)(headB))
              (equal(equalElements)(tailA)(tailB))
          })
          (false)
      })
      (hasNone(streamB))
  }

  startsWith(equal)(prefix)(stream) {
    prefix
      ((prefixHead)(prefixTail) {
        stream
          ((head)(tail) {
            and
              (equal(prefixHead)(head))
              (startsWith(equal)(prefixTail)(tail))
          })
          (false)
      })
      (true)
  }

  length {
    reduce(0)(constant(increment))
  }

  contains(predicate)(stream) {
    stream
      .filter(predicate)
      .hasSome
  }

  reverse {
    reduce(none)(some)
  }

  sort(comparator)(stream) {
    stream
      ((head)(tail) {
        single(head)
          .prepend(tail
            .filter(.comparator(head).not)
            .sort(comparator))
          .append(tail
            .filter(comparator(head))
            .sort(comparator))
      })
      (none)
  }

